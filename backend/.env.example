# =====================================================================
# Dolly POS - Environment Configuration Template
# =====================================================================

# PostgreSQL Database Configuration
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dollytoyskidswear

# JWT Authentication Secret Key (Generate a random 64-character secret)
SECRET_KEY=generate_a_secure_random_64_character_hex_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Master Security Key (Used for PIN override, destructive wipes, price edits)
# Default is 9999 (Configured in store_settings / Auth)

# Automated Database Backup Directory
BACKUP_DIR=C:\DollyPOS_Backups
